# Copy this file to ".env" and fill the values.

PORT=3000
# frontend url(s) allowed to call the API, comma separated
CORS_ORIGINS=http://localhost:3001

# needed to create a 2nd super admin (POST /auth/register/super-admin)
SUPER_ADMIN_SECRET=change-me

# JWT (expiry values are in SECONDS: 900 = 15 min, 604800 = 7 days)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=900
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
JWT_REFRESH_EXPIRES_IN=604800

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=sme_db
# true = auto create tables from entities (development only!)
DB_SYNC=true
# true = print every SQL query
DB_LOGGING=false

# Pusher (realtime) - create a free "Channels" app at https://dashboard.pusher.com
# leave empty -> app works, realtime is just turned off
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=ap2

# Email (optional) - leave MAIL_HOST empty to only print emails in the console
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=noreply@sme.app
